# Apps Script 웹 앱 URL 을 여기에 넣으세요.
# apps-script/README.md 의 "2. 웹 앱으로 배포" 에서 복사한 주소.
# 이 파일을 복사해서 ".env" 로 저장하고 값을 채우면 됩니다.
#
# 비워두면 앱이 "예시 데이터(오프라인 모드)"로 동작합니다 — 실제 시트 없이 화면을 미리 볼 수 있어요.
VITE_API_URL=

# Supabase 전환용 공개 연결 정보. 실제 전환 전까지 VITE_API_URL 과 함께 둘 수 있습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
